{
  "license": "proprietary",
  "name": "foodsharing/foodsharing",
  "description": "Network for foodsavers and foodsharers",
  "config": {
    "platform": {
      "php": "8.2"
    },
    "sort-packages": true,
    "allow-plugins": {
      "php-http/discovery": false,
      "codeception/c3": true
    }
  },
  "require-dev": {
    "codeception/c3": "^2.9",
    "codeception/codeception": "5.0.12",
    "codeception/module-asserts": "3.0.*",
    "codeception/module-cli": "2.0.*",
    "codeception/module-db": "3.1.*",
    "codeception/module-filesystem": "3.0.*",
    "codeception/module-phpbrowser": "3.0.*",
    "codeception/module-rest": "3.3.*",
    "codeception/module-sequence": "3.0.*",
    "codeception/module-symfony": "3.2.*",
    "codeception/module-webdriver": "^4.0",
    "fakerphp/faker": "1.23.*",
    "friendsofphp/php-cs-fixer": "3.52.*",
    "phpstan/phpstan": "1.10.63",
    "phpunit/phpunit": "^10.0",
    "rector/rector": "^1.0",
    "roave/security-advisories": "dev-latest",
    "robmorgan/phinx": "0.16.*",
    "symfony/stopwatch": "6.4.*",
    "symfony/web-profiler-bundle": "6.4.*"
  },
  "require": {
    "ext-dom": "*",
    "ext-fileinfo": "*",
    "ext-gd": "*",
    "ext-imagick": "*",
    "ext-imap": "*",
    "ext-intl": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-mysqli": "*",
    "ext-openssl": "*",
    "ext-pdo": "*",
    "ext-redis": "*",
    "ext-simplexml": "*",
    "ext-zlib": "*",
    "ddeboer/imap": "1.18.*",
    "doctrine/cache": "2.2.*",
    "doctrine/doctrine-bundle": "^2.11",
    "erusev/parsedown": "1.7.*",
    "exercise/htmlpurifier-bundle": "5.0.*",
    "friendsofsymfony/rest-bundle": "3.7.*",
    "html2text/html2text": "4.3.*",
    "jms/serializer-bundle": "5.4.*",
    "jsvrcek/ics": "0.8.5",
    "league/commonmark": "^2.4",
    "minishlink/web-push": "9.0.*",
    "mobiledetect/mobiledetectlib": "3.74.*",
    "nelmio/api-doc-bundle": "4.33.*",
    "nesbot/carbon": "2.66.*",
    "sensio/framework-extra-bundle": "6.2.*",
    "sentry/sentry-symfony": "5.1.*",
    "setasign/fpdi": "2.6.*",
    "symfony/asset": "6.4.*",
    "symfony/config": "6.4.*",
    "symfony/console": "6.4.*",
    "symfony/dependency-injection": "6.4.*",
    "symfony/error-handler": "6.4.*",
    "symfony/expression-language": "6.4.*",
    "symfony/form": "6.4.*",
    "symfony/framework-bundle": "6.4.*",
    "symfony/http-foundation": "6.4.*",
    "symfony/http-kernel": "6.4.*",
    "symfony/lock": "6.4.*",
    "symfony/mailer": "6.4.*",
    "symfony/rate-limiter": "6.4.*",
    "symfony/serializer-pack": "^1.3",
    "symfony/translation": "6.4.*",
    "symfony/twig-bridge": "6.4.*",
    "symfony/twig-bundle": "6.4.*",
    "symfony/validator": "6.4.*",
    "symfony/yaml": "6.4.*",
    "tecnickcom/tcpdf": "6.8.*",
    "google/auth": "^1.18",
    "guzzlehttp/guzzle": "*",
    "google/apiclient": "^2.15",
    "google/apiclient-services": "~0.300",
    "pkpass/pkpass": "^2.3.1",
    "twig/twig": "3.14.*",
    "twig/intl-extra": "3.8.*",
    "voku/bounce-mail-handler": "6.0.*",
    "zammad/zammad-api-client-php": "2.2.*"
  },
  "autoload": {
    "psr-4": {
      "Foodsharing\\": "src/",
      "Flourish\\": "src/Lib/Flourish"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "extra": {
    "public-dir": "assets",
    "symfony": {
      "require": "6.4.*"
    },
    "google/apiclient-services": [
      "Walletobjects"
    ]
  },
  "type": "project"
}
