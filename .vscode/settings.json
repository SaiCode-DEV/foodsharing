{
    "i18n-ally.localesPaths": [
        "translations"
    ],
    "i18n-ally.pathMatcher": "messages.{locale}.yml",
    "i18n-ally.enabledFrameworks": [
        "vue",
        "vue-sfc",
        "custom"
    ],
    "i18n-ally.keystyle": "nested",
    "search.exclude": {
        "**/node_modules": true,
        "**/bower_components": true,
        "**/*.code-search": true,
        "**/dist": true,
        "**/cache": true,
        "./assets/js": true,
        "./public": true,
        "./client/src/fonts": true,
        "./lib": true,
    },
    "i18n-ally.sourceLanguage": "de",
}