{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["../../client/src/*"]
    },
    "types": ["node", "@playwright/test"]
  },
  "include": [
    "./**/*.ts",
    "../../client/src/**/*.ts"
  ]
}
