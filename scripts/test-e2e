#!/usr/bin/env bash

dir=$(dirname "$0")

# shellcheck source=./__common.sh
source "$dir"/__common.sh

log-header "Running client e2e tests with playwright"
cd tests/e2e
npm ci && npx playwright install

export DB_HOST="localhost"
if [[ "${1:-}" == "test" ]]; then
  FS_ENV="test"
  log-header "Run on $FS_ENV containers ..."
  port=23005
  param="${*:2}"
  export DB_PORT="23306"
else
  FS_ENV="dev"
  log-header "Run on $FS_ENV containers ..."
  port=13005
  param="$@"
  export DB_PORT="13306"
fi

PW_TEST_CONNECT_WS_ENDPOINT=ws://127.0.0.1:$port/ npx playwright test $param
