#!/usr/bin/env bash
set -e  # Exit on error
export FS_ENV=test
dir=$(dirname "$0")
# shellcheck source=./__common.sh
source "$dir"/__common.sh

SCRIPT_START=$SECONDS

log-header "CI: Playwright E2E Tests"
echo ""

# Setup PHP environment
log-header "Setting up PHP environment"
bin/console foodsharing:setup

# Configure PHP-FPM paths for CI
tmpfile=$(mktemp)
sed "s#/app#$CI_PROJECT_DIR#g" /usr/local/etc/php-fpm.d/fpm.conf > "$tmpfile"
cat "$tmpfile" > /usr/local/etc/php-fpm.d/fpm.conf
rm "$tmpfile"

# Start PHP-FPM in background
php-fpm -R 2> php_fpm_err.log &
PHP_FPM_PID=$!

# Start mail queue worker
bin/console foodsharing:mailqueueworker &
MAIL_WORKER_PID=$!

# Trap to cleanup background processes on exit
trap "kill $PHP_FPM_PID $MAIL_WORKER_PID 2>/dev/null || true" EXIT

# Initialize database
log-header "Initializing database"
DB_START=$SECONDS
mariadb -u root -proot -hdb --execute="drop database if exists foodsharing; create database foodsharing"
vendor/bin/phinx migrate
vendor/bin/codecept foodsharing:test-seed
echo "✓ Database ready (${SECONDS}s elapsed)"

# Wait for assets
log-header "Waiting for assets"
ASSET_START=$SECONDS
wait-for-assets
echo "✓ Assets ready (${SECONDS}s elapsed)"

# Create database dump for Codeception
log-header "Creating database dump"
mariadb-dump --user root --password=root -hdb foodsharing > dump.sql
echo "✓ Dump created"

# Run Playwright tests
log-header "Running Playwright tests"
cd tests/e2e

# Install dependencies
npm install -g yarn@1.22.22 --force
yarn install --frozen-lockfile
# The CI image ships the browsers under $PLAYWRIGHT_BROWSERS_PATH. Installing
# only the engine this project needs keeps the step a no-op there and a small
# download anywhere else; WebKit is never run.
case "${PROJECT}" in
  *Firefox*) browser=firefox ;;
  *) browser=chromium ;;
esac
npx playwright install "${browser}"

PLAYWRIGHT_JUNIT_OUTPUT_NAME=../../tests/_output/report-playwright.xml \
    npx playwright test --project="${PROJECT}"

echo ""
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "✅ E2E tests completed"
echo "⏱️  Total time: $((SECONDS - SCRIPT_START))s"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
