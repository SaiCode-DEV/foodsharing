{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2019",
    "removeComments": true,
    "preserveConstEnums": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "typeRoots": ["./node_modules/@types"],
    "outDir": "dist"
  },
   "include": [
    "src/**/*.ts",
    "test.ts"
  ]
}
