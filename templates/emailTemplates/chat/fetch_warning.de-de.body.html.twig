<p>{{ ANREDE }} {{ NAME }}, </p>
<p></p>
<p>{{ 'email_template.fetch_warning.part1'|trans }}</p>
<ul>
{% for STORE in STORES %}
  <li>
    {# the colon belongs inside the anchor: the plain text part appends the url behind it #}
    <a href="{{ STORE.link }}" target="_blank">{{ STORE.name }}:</a>
    {{ 'email_template.fetch_warning.empty_slots'|trans({'%COUNT%': STORE.count}) }}
  </li>
{% endfor %}  
</ul>
<p>{{ 'email_template.fetch_warning.part2'|trans }}</p>

<footer>
  <small>
    {{ 'email_template.fetch_warning.disable_warning'|trans }}
    <a href="{{ SETTINGS }}" target="_blank">{{ 'email_template.fetch_warning.settings_link'|trans }}</a>
  </small>
</footer>