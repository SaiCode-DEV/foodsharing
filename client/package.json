{
  "name": "foodsharing-frontend",
  "version": "1.0.0",
  "private": true,
  "resolutions": {
    "get-intrinsic": "1.3.0",
    "gopd": "1.2.0",
    "es-define-property": "1.0.1"
  },
  "scripts": {
    "lint": "cd .. && client/bin/eslint --config eslint.config.mjs src client tests/e2e --max-warnings=0",
    "lint:markdown": "yarn run lint-markdown",
    "lint-markdown": "markdownlint --config ../.markdownlint.json",
    "prettier:e2e": "cd .. && prettier 'tests/e2e/**/*.ts' --check",
    "prettier:e2e:fix": "cd .. && prettier 'tests/e2e/**/*.ts' --write --list-different",
    "clean-assets": "shx rm -rf ../assets/*",
    "generate-openapi-types": "openapi-typescript ../docs/data/api_dump.json --type --output src/api/generated/openapi-types.d.ts",
    "build": "yarn clean-assets && NODE_ENV=production webpack --progress --no-watch",
    "dev": "yarn clean-assets && webpack serve --config serve.config.js --progress"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "~6.5.2",
