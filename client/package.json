{
  "name": "foodsharing-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "lint": "bin/eslint -c package.json",
    "lint:markdown": "yarn run lint-markdown",
    "lint-markdown": "markdownlint --config ../.markdownlint.json",
    "fix": "bin/eslint -c package.json --fix",
    "clean-assets": "shx rm -rf ../assets/*",
    "build": "yarn clean-assets && NODE_ENV=production webpack --progress --no-watch",
    "dev": "yarn clean-assets && webpack serve --config serve.config.js --hot --progress",
    "test": "node test"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.5.2",
    "@sentry/vue": "^9.8.0",
    "@vuelidate/core": "^2.0.3",
    "@vuelidate/validators": "^2.0.4",
    "axios": "^1.7.9",
    "bootstrap-vue": "^2.22.0",
    "copy-webpack-plugin": "^6.4.1",
    "dompurify": "^3.1.6",
    "emoji-picker-element-data": "^1.3.0",
    "eventemitter3": "^5.0.1",
    "leaflet": "^1.9.4",
    "leaflet.awesome-markers": "^2.0.5",
    "leaflet.markercluster": "^1.5.3",
    "libphonenumber-js": "^1.10.19",
    "liquor-tree": "^0.2.70",
    "markdown-it": "^12.3.2",
    "pinia": "^2.3.0",
    "pinia-plugin-persistedstate": "^4.0.1",
    "relative-time-format": "^1.1.6",
    "socket.io-client": "^4.8.1",
    "terser-webpack-plugin": "^5.3.11",
    "vue": "~2.7.14",
    "vue-advanced-chat": "^2.0.10",
    "vue-croppie": "^2.0.2",
    "vue-demi": "^0.14.10",
    "vue-multiselect": "^2.1.7",
    "vue-simple-suggest": "^1.11.2",
    "vue-slider-component": "~3.2.24",
    "vue-tel-input": "^5.11.0",
    "vue2-editor": "^2.10.3",
    "vue2-leaflet": "^2.7.1",
    "vue2-leaflet-locatecontrol": "^1.0.2",
    "vue2-leaflet-markercluster": "^3.1.0",
    "whatwg-fetch": "^3.6.2",
    "workbox-webpack-plugin": "^7.3.0",
    "workbox-window": "^7.3.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.2",
    "@babel/preset-env": "^7.20.2",
    "@vue/test-utils": "~1.3.6",
    "assert": "^2.1.0",
    "babel-eslint": "^10.1.0",
    "babel-loader": "~8.3.0",
    "css-loader": "^3.6.0",
    "eslint": "<8.0.0",
    "eslint-config-standard": "^16.0.3",
    "eslint-loader": "~4.0.2",
    "eslint-plugin-html": "~6.2.0",
    "eslint-plugin-import": "~2.27.5",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "<6.0.0",
    "eslint-plugin-vue": "<8.0.0",
    "exports-loader": "^0.7.0",
    "file-loader": "~6.2.0",
    "glob": "^8.1.0",
    "imports-loader": "^5.0.0",
    "jsdom": "^25.0.1",
    "jsdom-global": "^3.0.2",
    "json-loader": "^0.5.7",
    "loader-utils": "^2.0.4",
    "markdownlint-cli": "0.33.0",
    "mini-css-extract-plugin": "^1.6.2",
    "mkdirp": "^2.1.3",
    "mocha": "~10.8.2",
    "node-localstorage": "^2.2.1",
    "null-loader": "^4.0.1",
    "process": "^0.11.10",
    "sass": "~1.55.0",
    "sass-loader": "~10.4.1",
    "shx": "^0.3.4",
    "sinon": "^19.0.2",
    "style-loader": "^1.3.0",
    "thread-loader": "^4.0.4",
    "url-loader": "^4.1.1",
    "vue-eslint-parser": "<8.0.0",
    "vue-loader": "~15.10.1",
    "vue-template-compiler": "~2.7.14",
    "webpack": "~5.94.0",
    "webpack-bundle-analyzer": "~4.10.2",
    "webpack-cli": "~5.1.4",
    "webpack-dev-server": "~5.2.0",
    "webpack-merge": "~5.10.0",
    "yaml-loader": "0.6.0"
  },
  "eslintConfig": {
    "parser": "vue-eslint-parser",
    "parserOptions": {
      "parser": "babel-eslint"
    },
    "env": {
      "browser": true
    },
    "extends": [
      "standard",
      "plugin:vue/recommended"
    ],
    "rules": {
      "comma-dangle": [
        "error",
        "always-multiline"
      ],
      "object-curly-spacing": [
        "error",
        "always"
      ],
      "vue/no-v-html": [
        "error"
      ],
      "vue/custom-event-name-casing": [
        "error",
        "kebab-case",
        {
          "ignores": [
            "bv::hide::tooltip"
          ]
        }
      ],
      "vue/v-on-event-hyphenation": [
        "error",
        "always"
      ],
      "vue/max-attributes-per-line": [
        "error",
        {
          "singleline": 2,
          "multiline": {
            "max": 1,
            "allowFirstLine": false
          }
        }
      ]
    },
    "overrides": [
      {
        "files": [
          "*.test.js"
        ],
        "env": {
          "mocha": true
        }
      }
    ]
  },
  "eslintIgnore": [
    "test/_compiled.js"
  ],
  "browserslist": [
    ">0.2%",
    "not dead",
    "not op_mini all",
    "last 2 versions"
  ]
}
